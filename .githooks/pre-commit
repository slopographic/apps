#!/bin/sh
# Refuses a commit unless it is authored as Slopographic and its message carries no Claude attribution.
# Enable once per clone: git config core.hooksPath .githooks   (tests/node/attribution.test.mjs checks it is on)
name=$(git config user.name)
email=$(git config user.email)
if [ "$name" != "slopographic" ] || [ "$email" != "340656300+slopographic@users.noreply.github.com" ]; then
  echo "pre-commit: commits must be authored as Slopographic <noreply@slopographic.com> (now: $name <$email>)." >&2
  echo "Fix with: git config user.name Slopographic && git config user.email noreply@slopographic.com" >&2
  exit 1
fi
msg=$(git log -1 --format=%B 2>/dev/null)
# The file rules (tools/check-rules.mjs): at most 300 lines per source file, and a test that names each staged script.
if command -v node >/dev/null 2>&1; then
  node tools/check-rules.mjs --staged >/dev/null || { node tools/check-rules.mjs --staged; echo "pre-commit: fix the files above (rules: tools/check-rules.mjs)." >&2; exit 1; }
fi
# Cache bust: the precache list and the service worker VERSION follow the files (tools/pwa-precache.mjs). The commit takes
# the regenerated files, so a release that changes a cached file always reaches returning visitors.
if command -v node >/dev/null 2>&1; then
  node tools/pwa-precache.mjs >/dev/null || { echo "pre-commit: node tools/pwa-precache.mjs failed." >&2; exit 1; }
  git add service-worker.js sw-precache*.js
fi
# The AI coverage audit follows the apps' commands (tools/ai-coverage.mjs; tests/node/ai-coverage.test.mjs checks it).
if command -v node >/dev/null 2>&1; then
  node tools/ai-coverage.mjs --index >/dev/null && git add shared/commands/AI-COVERAGE.md shared/ai/app-skills.js
fi
exit 0
